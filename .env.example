# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-telegram-token

# Провайдер ИИ: anthropic (Claude API) или openrouter
AI_PROVIDER=anthropic

# Для AI_PROVIDER=anthropic — ключ Claude API: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Для AI_PROVIDER=openrouter — ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модель. Для anthropic: claude-opus-5-5 (по умолчанию) или дешевле claude-sonnet-5-5.
# Для openrouter: ID модели из каталога https://openrouter.ai/models (формат "провайдер/модель").
# Нужна модель с поддержкой structured outputs (JSON schema); иначе бот попросит JSON текстом.
AI_MODEL=claude-opus-5-5

DB_PATH=geopolitics.db
START_YEAR=2026
MAX_ACTIONS_PER_TURN=5
ADVISOR_COOLDOWN_SEC=20
